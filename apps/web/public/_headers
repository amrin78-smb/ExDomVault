# Security headers for the SPA's HTML and static assets (Workers static assets apply this file to
# asset responses, including the single-page-application fallback). API responses (/api/*) are
# produced by the Worker, which sets its own stricter headers (worker/middleware/security-headers.ts).
#
# CSP notes: the production build has no inline scripts or <style> blocks (Vite emits external
# module scripts and one stylesheet; Tailwind 4 compiles to that stylesheet). React applies `style`
# props through the CSSOM (element.style), which CSP does not restrict, so no 'unsafe-inline' is
# needed. Keep this in sync with the test in worker/middleware/security-headers.test.ts.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

