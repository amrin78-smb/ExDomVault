/**
 * ExDomainVault Cloudflare Worker: serves the React SPA as static assets and the /api/v1 API.
 * Configuration reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets are never set here. Use `wrangler secret put` for production and `.dev.vars` locally.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "exdomainvault",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // Served at https://exdomainvault.amrin78.workers.dev behind Cloudflare Access. Per-version preview
  // URLs are disabled so no unprotected alternate hostname exists.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    // API paths must always reach the Worker, never fall back to index.html.
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "hyperdrive": [
    {
      // Neon PostgreSQL (production branch) via Cloudflare Hyperdrive "exdomainvault-db", connecting as
      // the least-privilege role exdomainvault_app to Neon's direct endpoint. Local dev ignores this id
      // and connects straight to the checked-out Neon branch (see vite.config.ts).
      "binding": "HYPERDRIVE",
      "id": "c43bce859dcd405c9aaca22897818529",
    },
  ],
  "vars": {
    // Production default. Local development overrides this in .dev.vars.
    "APP_ENV": "production",
    "APP_VERSION": "0.1.0",
    // Production authentication: Cloudflare Access. Until ACCESS_TEAM_DOMAIN and ACCESS_AUD are set,
    // every protected API route returns 503 (fail closed). See docs/deployment.md.
    "AUTH_PROVIDER": "cloudflare_access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // BOOTSTRAP_ADMIN_EMAILS (comma-separated emails that become administrators on first sign-in)
    // is a Worker secret in production so it is not committed: `wrangler secret put`.
  },
}
