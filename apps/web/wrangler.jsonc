/**
 * ExDomainVault Cloudflare Worker: serves the React SPA as static assets and the /api/v1 API.
 * Configuration reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets are never set here. Use `wrangler secret put` for production and `.dev.vars` locally.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "exdomainvault",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // Served at https://exdomainvault.amrin78.workers.dev behind Cloudflare Access. Per-version preview
  // URLs are disabled so no unprotected alternate hostname exists.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    // API paths must always reach the Worker, never fall back to index.html.
    "run_worker_first": ["/api/*"],
  },
  // Housekeeping every 5 minutes: requeue jobs with expired leases, expire verification challenges,
  // prune worker request nonces, schedule daily passive monitoring jobs.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "hyperdrive": [
    {
      // Neon PostgreSQL (production branch) via Cloudflare Hyperdrive "exdomainvault-db", connecting as
      // the least-privilege role exdomainvault_app to Neon's direct endpoint. Local dev ignores this id
      // and connects straight to the checked-out Neon branch (see vite.config.ts).
      "binding": "HYPERDRIVE",
      "id": "c43bce859dcd405c9aaca22897818529",
    },
  ],
  "vars": {
    // Production default. Local development overrides this in .dev.vars.
    "APP_ENV": "production",
    "APP_VERSION": "0.1.0",
    // Production authentication: Cloudflare Access (Worker "Access" tab, policy allows the owner only).
    // These are public identifiers, not secrets. If ACCESS_TEAM_DOMAIN or ACCESS_AUD is emptied,
    // every protected API route returns 503 (fail closed). See docs/deployment.md.
    "AUTH_PROVIDER": "cloudflare_access",
    "ACCESS_TEAM_DOMAIN": "fragrant-grass-4d8f.cloudflareaccess.com",
    "ACCESS_AUD": "e777f0cfe2a4f69ed8221bbbfd3fb02b0bf297b4cfc1d0247df9d5f080683b41",
    // Active (target-contacting) scan profiles. Enabled 2026-10-22 by the owner after the
    // Milestone 6 security gate passed (docs/progress.md). Set to "false" to stop all active
    // scanning: new jobs are refused and in-flight jobs are cancelled at their next heartbeat.
    "ACTIVE_SCANNING_ENABLED": "true",
    // BOOTSTRAP_ADMIN_EMAILS (comma-separated emails that become administrators on first sign-in)
    // is a Worker secret in production so it is not committed: `wrangler secret put`.
  },
}
