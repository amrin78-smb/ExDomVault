/**
 * ExDomainVault Cloudflare Worker: serves the React SPA as static assets and the /api/v1 API.
 * Configuration reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets are never set here. Use `wrangler secret put` for production and `.dev.vars` locally.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "exdomainvault",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // API paths must always reach the Worker, never fall back to index.html.
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "hyperdrive": [
    {
      // Neon PostgreSQL via Cloudflare Hyperdrive (pooled at the edge, origin = Neon direct endpoint).
      // PLACEHOLDER id: replace with the real id from `wrangler hyperdrive create` before deploying
      // (see docs/deployment.md). Local dev ignores the id and connects straight to Neon using
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE, set by vite.config.ts.
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "vars": {
    // Production default. Local development overrides this in .dev.vars.
    "APP_ENV": "production",
    "APP_VERSION": "0.1.0",
    // Production authentication: Cloudflare Access. Until ACCESS_TEAM_DOMAIN and ACCESS_AUD are set,
    // every protected API route returns 503 (fail closed). See docs/deployment.md.
    "AUTH_PROVIDER": "cloudflare_access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Comma-separated emails that become administrators on first sign-in.
    "BOOTSTRAP_ADMIN_EMAILS": "",
  },
}
