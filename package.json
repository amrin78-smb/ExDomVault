{
  "name": "exdomainvault",
  "private": true,
  "version": "0.1.0",
  "description": "External Domain Security & Exposure Monitoring",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "packages/shared",
    "packages/database",
    "packages/rules"
  ],
  "scripts": {
    "dev": "npm run dev -w @exdomainvault/web",
    "build": "npm run build -w @exdomainvault/web",
    "preview": "npm run preview -w @exdomainvault/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "npm run cf-typegen -w @exdomainvault/web",
    "worker:install": "python3 -m venv worker/.venv && worker/.venv/bin/pip install --upgrade pip && worker/.venv/bin/pip install -r worker/requirements.txt -r worker/requirements-dev.txt && worker/.venv/bin/pip install --no-deps -e worker",
    "worker:lint": "cd worker && .venv/bin/ruff check . && .venv/bin/ruff format --check .",
    "worker:test": "cd worker && .venv/bin/pytest",
    "worker:audit": "bash scripts/audit-python.sh",
    "audit:npm": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=critical",
    "db:generate": "npm run db:generate -w @exdomainvault/database",
    "db:migrate": "npm run db:migrate -w @exdomainvault/database",
    "db:check": "npm run db:check -w @exdomainvault/database",
    "rules:docs": "node scripts/generate-rules-doc.ts",
    "rules:docs:check": "node scripts/generate-rules-doc.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
