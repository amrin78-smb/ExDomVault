# Periodic health check for the ExDomainVault worker (optional; triggered by
# exdomainvault-worker-health.timer). Runs `exdomainvault-worker --health`, which reads the health
# file the running worker writes. A failed run shows in `systemctl --failed` and the journal.

[Unit]
Description=ExDomainVault worker health check
Documentation=file:/opt/exdomainvault-worker/README.md
After=exdomainvault-worker.service

[Service]
Type=oneshot
User=exdomainvault-worker
Group=exdomainvault-worker
WorkingDirectory=/opt/exdomainvault-worker
EnvironmentFile=/etc/exdomainvault/worker.env
LoadCredential=worker.key:/etc/exdomainvault/worker.key
Environment=EXDV_PRIVATE_KEY_FILE=%d/worker.key
Environment=EXDV_HEALTH_FILE=/var/lib/exdomainvault-worker/health.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/exdomainvault-worker/.venv/bin/exdomainvault-worker --health
TimeoutStartSec=30s

StateDirectory=exdomainvault-worker
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/exdomainvault
MemoryMax=128M
TasksMax=8
