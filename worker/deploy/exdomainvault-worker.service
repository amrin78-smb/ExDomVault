# ExDomainVault home scanning worker. Installation: docs/home-worker-setup.md.
# Install to /etc/systemd/system/exdomainvault-worker.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now exdomainvault-worker
#
# Outbound HTTPS only; the service listens on no port. Requires systemd >= 250 (Ubuntu 24.04: 255).

[Unit]
Description=ExDomainVault home scanning worker
Documentation=file:/opt/exdomainvault-worker/README.md
Wants=network-online.target
After=network-online.target time-sync.target
# Give up after 5 failed starts in 10 minutes (e.g. invalid configuration); fix, then
# `systemctl reset-failed exdomainvault-worker` and start again.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=exdomainvault-worker
Group=exdomainvault-worker
WorkingDirectory=/opt/exdomainvault-worker

# Configuration (0640 root:exdomainvault-worker). Read by systemd, not by the worker process.
EnvironmentFile=/etc/exdomainvault/worker.env
# The Ed25519 private key stays root-owned (0600) at rest. systemd copies it into a private,
# non-swappable credentials directory readable only by this service ($CREDENTIALS_DIRECTORY, %d).
# Do NOT set EXDV_PRIVATE_KEY_FILE in worker.env: EnvironmentFile= takes precedence over
# Environment=, and /etc/exdomainvault is inaccessible to the service.
LoadCredential=worker.key:/etc/exdomainvault/worker.key
Environment=EXDV_PRIVATE_KEY_FILE=%d/worker.key
Environment=EXDV_HEALTH_FILE=/var/lib/exdomainvault-worker/health.json
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Fail fast with a clear journal entry if the configuration is invalid.
ExecStartPre=/opt/exdomainvault-worker/.venv/bin/exdomainvault-worker --check-config
ExecStart=/opt/exdomainvault-worker/.venv/bin/exdomainvault-worker
Restart=on-failure
RestartSec=30s
TimeoutStopSec=60s

# State: /var/lib/exdomainvault-worker (health file). The only writable path.
StateDirectory=exdomainvault-worker
StateDirectoryMode=0700
UMask=0077

# --- Sandboxing -----------------------------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# CPython 3.12 (no JIT), cryptography and cffi do not need writable+executable memory.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# No capabilities at all. Milestone 6 port checks use unprivileged TCP connect, not raw sockets.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The worker process itself never needs to read these: systemd reads worker.env and worker.key.
InaccessiblePaths=-/etc/exdomainvault

# --- Egress: keep the worker off the home LAN (design §12, worker isolation) ----------------------
# Public internet is allowed (API, public resolvers, RDAP, and in-scope scan targets). The deny list
# mirrors the worker's prohibited-address table (worker/app/policy.py): loopback, private, CGNAT,
# link-local, multicast, reserved, documentation, benchmarking, broadcast, IPv4-embedding IPv6
# transition prefixes (mapped, NAT64, 6to4, Teredo), ULA, site-local, and all IPv6 outside 2000::/3.
# IPAddressAllow= wins over IPAddressDeny=, so only the systemd-resolved stub that /etc/resolv.conf
# points at stays reachable. The application-level scope validator remains the primary control
# (it also denies this host's own and egress addresses); this is defence in depth. If
# EXDV_DNS_RESOLVERS names a LAN resolver, add it to IPAddressAllow.
IPAddressAllow=127.0.0.53/32
IPAddressDeny=localhost link-local multicast
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12
IPAddressDeny=192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15
IPAddressDeny=198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4 255.255.255.255/32
IPAddressDeny=::/128 ::1/128 ::ffff:0:0/96 ::ffff:0:0:0/96 ::/96 64:ff9b::/96 64:ff9b:1::/48
IPAddressDeny=100::/64 2001::/23 2001::/32 2001:2::/48 2001:10::/28 2001:20::/28 2001:db8::/32
IPAddressDeny=3fff::/20 2002::/16 fc00::/7 fe80::/10 fec0::/10 ff00::/8
# Everything outside global unicast 2000::/3.
IPAddressDeny=::/3 4000::/2 8000::/1

# --- Resource limits ------------------------------------------------------------------------------
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
CPUQuota=50%
LimitNOFILE=4096
Nice=5

[Install]
WantedBy=multi-user.target
