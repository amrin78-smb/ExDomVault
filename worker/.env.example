# ExDomainVault worker configuration. Copy to /etc/exdomainvault/worker.env (mode 0600) in
# production or worker/.env for local development. Never commit real values.

# Base URL of the ExDomainVault application. Must be https:// outside development.
EXDV_API_BASE_URL=https://exdomainvault.example.com
# Stable identifier for this worker, registered in the application (Milestone 4).
EXDV_WORKER_ID=home-worker-01
# development | production
EXDV_ENVIRONMENT=production
# Seconds between job-claim polls.
EXDV_POLL_INTERVAL_SECONDS=30
# DEBUG | INFO | WARNING | ERROR
EXDV_LOG_LEVEL=INFO
