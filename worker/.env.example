# ExDomainVault worker configuration — PLACEHOLDERS ONLY. Never commit real values.
# Production: copy to /etc/exdomainvault/worker.env (0640 root:exdomainvault-worker); see
# docs/home-worker-setup.md. Local development: copy to worker/.env (git-ignored).
# The variables are specified in docs/worker-protocol.md ("Worker configuration").

# --- Required ---------------------------------------------------------------------------------------

# Base URL of the ExDomainVault application, no trailing path. https is required unless
# EXDV_ENVIRONMENT=development and the host is localhost / 127.0.0.1 / ::1.
EXDV_API_BASE_URL=https://exdomainvault.example.com

# Worker name as registered in Settings -> Scanning workers (informational; appears in logs).
EXDV_WORKER_ID=home-worker-01

# Credential id (UUID) shown after registering this worker's public key.
EXDV_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the PEM (PKCS#8) Ed25519 private key. Must not be group- or world-readable.
# Under the systemd unit this is overridden with the LoadCredential= copy, so the value here is
# only used for manual runs.
EXDV_PRIVATE_KEY_FILE=/etc/exdomainvault/worker.key

# --- Optional ---------------------------------------------------------------------------------------

# Cloudflare Access service token, sent as CF-Access-Client-Id / CF-Access-Client-Secret.
# Needed when the application hostname is behind Cloudflare Access. Set both or neither.
EXDV_ACCESS_CLIENT_ID=replace-with-client-id.access
EXDV_ACCESS_CLIENT_SECRET=replace-with-client-secret

# production (default) | development
EXDV_ENVIRONMENT=production

# Seconds between claim polls while idle, 5-3600 (default 30).
EXDV_POLL_INTERVAL_SECONDS=30

# Comma-separated scan profiles to claim (default passive), e.g. passive,quick,standard. Active
# profiles are refused unless EXDV_ACTIVE_SCANNING_ENABLED=true below.
EXDV_PROFILES=passive

# Active (target-connecting) checks: TLS, HTTP, TCP ports. Off unless exactly "true". Every
# connection still passes the scope validator, and the server has its own switch as well.
EXDV_ACTIVE_SCANNING_ENABLED=false

# Extra networks this worker must never contact, on top of the built-in prohibited ranges:
# comma-separated canonical CIDRs (host bits zero) or single addresses, at most 100.
# Put this home's public IP here (and its IPv6 /64 prefix). While active scanning is enabled the
# worker also auto-detects its interface addresses and its public egress IP (a whoami.cloudflare
# CHAOS TXT query to 1.1.1.1), hourly; set the value explicitly anyway if the IP is static. If the
# egress IP cannot be detected and this list is empty, web/network checks fail closed
# (egress_ip_unknown). IPv6-only hosts must list their prefix here.
# EXDV_DENY_NETWORKS=203.0.113.7/32,2001:db8:1234:5678::/64

# Nmap binary for tcp_ports / service_identification (default /usr/bin/nmap). Network checks are
# refused if it is missing.
# EXDV_NMAP_PATH=/usr/bin/nmap

# Comma-separated resolver IP addresses. Default (unset): public resolvers 1.1.1.1, 9.9.9.9 and their
# IPv6 equivalents. "system" uses the host's resolver (systemd-resolved answers DS queries with
# SERVFAIL, so DNSSEC record checks fail with it).
# EXDV_DNS_RESOLVERS=1.1.1.1,9.9.9.9

# Health JSON written by the running worker and read by --health.
EXDV_HEALTH_FILE=/var/lib/exdomainvault-worker/health.json

# DEBUG | INFO | WARNING | ERROR (default INFO)
EXDV_LOG_LEVEL=INFO
